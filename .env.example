# ============================================================
# Twibbon Al Akhyar — environment variables
# Copy to `.env` and fill in. Guest editor works without any of
# these; auth + upload require Google OAuth to be configured.
# ============================================================

# --- Database (Prisma, MySQL) ---
# Format: mysql://USER:PASSWORD@HOST:3306/DBNAME
# Di CloudPanel: buat Database + user lewat menu "Databases", lalu isi di sini.
# Host lokal VPS biasanya 127.0.0.1. Encode karakter spesial pada password
# (mis. @ -> %40, # -> %23).
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DBNAME"

# --- Auth.js (NextAuth v5) ---
# Generate a secret: `openssl rand -base64 32`
AUTH_SECRET="ganti-dengan-secret-acak"
# URL publik aplikasi (wajib di produksi, di belakang reverse proxy CloudPanel).
AUTH_URL="https://twibbon.alakhyar.sch.id"
# Percayai header proxy (X-Forwarded-*) dari Nginx CloudPanel.
AUTH_TRUST_HOST="true"

# Google OAuth 2.0 credentials (console.cloud.google.com > Credentials)
# Authorized redirect URI: https://twibbon.alakhyar.sch.id/api/auth/callback/google
# For local dev also add: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Only emails ending in this suffix (or its subdomains) may log in.
# e.g. alakhyar.sch.id also allows sd.alakhyar.sch.id, smp.alakhyar.sch.id
ALLOWED_EMAIL_DOMAIN="alakhyar.sch.id"

# Public base URL (used for OG tags / absolute links)
NEXT_PUBLIC_SITE_URL="https://twibbon.alakhyar.sch.id"

# Where uploaded twibbon PNGs are stored on disk (local storage driver).
# In production point this at a mounted volume or swap the storage driver
# in src/lib/storage.ts for GCS/S3.
STORAGE_DIR="./storage"
