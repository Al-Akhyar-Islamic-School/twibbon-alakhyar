# ============================================================
# Twibbon Al Akhyar — environment variables
# Produksi: set di Netlify UI (context Production) — lihat DEPLOY.md.
# Dev lokal (opsional): salin ke `.env` dan pakai MySQL lokal + emulator S3
# (R2_ENDPOINT). Jangan arahkan dev lokal ke DB/bucket produksi.
# ============================================================

# --- Database (Prisma, MySQL-compatible: TiDB Cloud Starter) ---
# Produksi (TiDB): mysql://<prefix>.root:<PASSWORD>@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/twibbon?sslaccept=strict&connection_limit=3
# Dev lokal: mysql://root:PASSWORD@127.0.0.1:3306/twibbon_local
# Encode karakter spesial pada password (mis. @ -> %40, # -> %23).
DATABASE_URL="mysql://root:PASSWORD@127.0.0.1:3306/twibbon_local"

# --- Storage (Cloudflare R2) ---
# Produksi: bucket `twibbon-alakhyar`, token "Object Read & Write" yang
# dibatasi HANYA ke bucket itu (bukan token eRapor / token akun-wide).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="twibbon-alakhyar"
# Hanya untuk dev lokal dengan emulator S3 (mis. MinIO). JANGAN di-set di Netlify.
# R2_ENDPOINT="http://127.0.0.1:9000"

# --- Auth.js (NextAuth v5) ---
# Generate: `openssl rand -base64 32`. Selama migrasi, pakai nilai yang sama
# dengan VPS agar sesi staf tetap valid.
AUTH_SECRET="ganti-dengan-secret-acak"
# Host diturunkan dari header platform (trustHost). AUTH_URL tidak perlu di-set
# di Netlify; isi hanya bila menjalankan di balik proxy yang tidak meneruskan host.
AUTH_TRUST_HOST="true"
# AUTH_URL="https://twibbon.alakhyar.sch.id"

# Google OAuth 2.0 credentials (console.cloud.google.com > Credentials)
# Redirect URI: https://twibbon.alakhyar.sch.id/api/auth/callback/google
# Dev lokal juga: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Only emails ending in this suffix (or its subdomains) may log in.
# e.g. alakhyar.sch.id also allows sd.alakhyar.sch.id, smp.alakhyar.sch.id
ALLOWED_EMAIL_DOMAIN="alakhyar.sch.id"

# Public base URL (used for OG tags / absolute links)
NEXT_PUBLIC_SITE_URL="https://twibbon.alakhyar.sch.id"

# --- Operasional ---
# Secret untuk /api/cron/cleanup (scheduled function harian & `npm run cleanup`).
# Generate: `openssl rand -hex 32`
CRON_SECRET=""
# Saklar pemeliharaan: "1" menolak upload/edit/hapus twibbon (503).
UPLOADS_FROZEN=""
