{
  "name": "twibbon-alakhyar",
  "version": "1.0.0",
  "private": true,
  "description": "Twibbon Al Akhyar — PWA pembuat twibbon Yayasan Al Akhyar",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "cleanup": "node scripts/cleanup.mjs",
    "migrate:verify-db": "node scripts/migrate/verify-db.mjs",
    "migrate:upload-r2": "node scripts/migrate/upload-r2.mjs",
    "migrate:verify-r2": "node scripts/migrate/verify-r2.mjs",
    "migrate:delta-logs": "node scripts/migrate/delta-logs.mjs",
    "migrate:download-r2": "node scripts/migrate/download-r2.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "deploy:update": "npm ci && npm run build && npm run db:push && pm2 startOrReload ecosystem.config.cjs --update-env"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@netlify/functions": "^6.0.2",
    "@prisma/client": "^5.22.0",
    "next": "14.2.35",
    "next-auth": "5.0.0-beta.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "prisma": "^5.22.0",
    "typescript": "^5.5.3"
  }
}
